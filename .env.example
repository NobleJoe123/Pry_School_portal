# ==============================================================================
# Primary School Portal - Environment Variables Template
# Copy this file to `.env` and populate values before running the application.
# ==============================================================================

# --- Security ---
# In production, generate a cryptographically secure key of at least 50 chars:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-secure-unpredictable-secret-key-in-production

# Set to False for production! Defaults to False if omitted.
DEBUG=False

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CSRF trusted origins for POST requests from external domains
CSRF_TRUSTED_ORIGINS=https://portal.yourdomain.com

# Optional superuser credentials to automatically create on first container run
# In production, weak default admin credentials will NEVER be created automatically.
# DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
# DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password
# DJANGO_SUPERUSER_USERNAME=admin

# --- Database ---
DB_NAME=pry_school_portal
DB_USER=portal_user
DB_PASSWORD=replace_with_strong_db_password
DB_HOST=db
DB_PORT=5432

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=/api

# --- pgAdmin (optional management interface) ---
PGADMIN_DEFAULT_EMAIL=admin@portal.com
PGADMIN_DEFAULT_PASSWORD=replace_with_strong_pgadmin_password

# --- Cloudinary (Media storage - optional in dev) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payment Gateways (Optional) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
